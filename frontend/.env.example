# Copy to .env.local and adjust. Only PUBLIC values belong here:
# anything starting with VITE_ is bundled into the browser code.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" (or legacy "anon") key. NEVER put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY